rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Admin authorization must come from trusted Firebase custom claims, never a client-editable profile field.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function owns(ownerUid) { return signedIn() && request.auth.uid == ownerUid; }
    function published() { return resource.data.status == 'published' && resource.data.approvalStatus == 'approved'; }

    match /destinations/{id} { allow read: if published() || isAdmin(); allow write: if isAdmin(); }
    match /categories/{id} { allow read: if published() || isAdmin(); allow write: if isAdmin(); }
    match /articles/{id} { allow read: if published() || isAdmin(); allow write: if isAdmin(); }
    match /packages/{id} { allow read: if published() || isAdmin(); allow write: if isAdmin(); }
    match /banners/{id} { allow read: if published() || isAdmin(); allow write: if isAdmin(); }

    match /businesses/{id} {
      allow read: if published() || isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if false; // All mutations pass through trusted server APIs.
    }

    match /products/{id} {
      allow read: if published() || isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if false; // Server APIs enforce ownership, moderation and quotas.
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName','email','createdAt','updatedAt']);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasNone(['role','admin','verified']);
      allow delete: if isAdmin();
    }
    // Financial records, proof files, subscriptions, promotion approvals and audit logs are server/admin only.
    match /transactions/{id} { allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid); allow write: if false; }
    match /paymentProofs/{id} { allow read, write: if false; }
    match /subscriptions/{id} { allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid); allow write: if false; }
    match /promotions/{id} { allow read: if (resource.data.status == 'active' && resource.data.approvalStatus == 'approved') || isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid); allow write: if false; }
    match /adminActivityLogs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /ratings/{id} { allow read, write: if false; }
    match /ratingRateLimits/{id} { allow read, write: if false; }
    match /accountDeletionRequests/{id} { allow read, write: if false; }
    match /notifications/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}

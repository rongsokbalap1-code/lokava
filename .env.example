# Public Firebase web configuration (safe to expose only when Firebase Security Rules are correct)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only secrets — never use NEXT_PUBLIC_ prefix
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# All user-uploaded images (business/product photos, payment QR, payment proofs) use Cloudinary.
# Keep these secrets server-side; never prefix them with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required to hash anonymous rating anti-abuse keys; use a long random value.
RATING_HASH_SECRET=
# Fallback public canonical origin; the primary domain can also be set in Admin → Pengaturan situs publik.
NEXT_PUBLIC_SITE_URL=
